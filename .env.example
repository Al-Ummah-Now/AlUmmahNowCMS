# Al Ummah Now CMS Environment Configuration

# Authentication Configuration for auth.alummahnow.net
AUTH_CLIENT_ID=al-ummah-now-cms
AUTH_CLIENT_SECRET=your-client-secret-here

# Cloudflare Configuration
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_ZONE_ID=your-cloudflare-zone-id

# Database Configuration (handled by wrangler.json)
# DB binding is configured in wrangler.json

# R2 Storage Configuration (handled by wrangler.json)
# R2 bucket binding is configured in wrangler.json

# Development Configuration
DEV_MODE=true