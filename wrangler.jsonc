{
  // Top level = production. `--env stage` and `--env qa` override name, routes, bindings and vars.
  // Bindings are not inherited by envs, so every env lists them in full.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-ummah-now-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_vars": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers AI: the AI assist model (docs/AI_ASSIST_SPEC.md §2). Not inherited by envs: each env repeats it.
  "ai": { "binding": "AI" },
  "routes": [{ "pattern": "cms.alummahnow.net", "custom_domain": true }],
  // */30: snapshot refreshes, image variant sweep, feed verifier. Every minute: scheduled posts going
  // live onto the home timeline (src/lib/feed/jobs.ts duePosts). Not inherited by envs: each env repeats them.
  "triggers": { "crons": ["*/30 * * * *", "* * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_URL": "https://cms.alummahnow.net",
    "AUTH_ISSUER": "https://auth.alummahnow.net",
    "AUTH_CLIENT_ID": "d06fd65a-5b79-45bc-8bfd-a856b8502330",
    "VIDEOS_API_URL": "https://videos.api.alummahnow.net",
    "VIDEOS_WEB_URL": "https://videos.alummahnow.net",
    "ADMIN_API_URL": "https://admin.api.alummahnow.net",
    "ADMIN_WEB_URL": "https://admin.alummahnow.net",
    "WWW_URL": "https://www.alummahnow.net",
    "WWW_ORIGINS": "https://www.alummahnow.net"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "al-ummah-now-cms",
      "database_id": "ad825428-5f0d-4d0b-878b-45b94e3c9c63",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "al-ummah-now-cms" }],
  // www's home timeline (docs/FEED.md): written only by this Worker, read by www (binding FEED there too).
  "kv_namespaces": [{ "binding": "FEED", "id": "5f27cddf86c84bbdbb59445ad867253c" }],
  // Image variant jobs (src/lib/variants/jobs.ts, CMS-10), AI assist jobs (docs/AI_ASSIST_SPEC.md §3) and home timeline builds (src/lib/feed/jobs.ts:
  // one consumer at a time so builds never overlap, retries with backoff, then the DLQ, whose consumer
  // flags the admin). Not inherited by envs: each env repeats them.
  "queues": {
    "producers": [{ "binding": "VARIANTS", "queue": "al-ummah-now-cms-variants" }, { "binding": "FEED_JOBS", "queue": "al-ummah-now-cms-feed" }, { "binding": "AI_JOBS", "queue": "al-ummah-now-cms-ai" }],
    "consumers": [
      { "queue": "al-ummah-now-cms-variants", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 6, "max_concurrency": 4, "dead_letter_queue": "al-ummah-now-cms-variants-dlq" },
      { "queue": "al-ummah-now-cms-feed", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 6, "max_concurrency": 1, "dead_letter_queue": "al-ummah-now-cms-feed-dlq" },
      { "queue": "al-ummah-now-cms-feed-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
      { "queue": "al-ummah-now-cms-ai", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5, "dead_letter_queue": "al-ummah-now-cms-ai-dlq" },
      { "queue": "al-ummah-now-cms-ai-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  "dev": { "ip": "localhost", "port": 8585, "local_protocol": "http" },
  "env": {
    "stage": {
      "name": "al-ummah-now-cms-stage",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ai": { "binding": "AI" },
      "routes": [{ "pattern": "cms.stage.alummahnow.net", "custom_domain": true }],
      "triggers": { "crons": ["*/30 * * * *", "* * * * *"] },
      "vars": {
        "ENVIRONMENT": "stage",
        "PUBLIC_URL": "https://cms.stage.alummahnow.net",
        "AUTH_ISSUER": "https://auth.stage.alummahnow.net",
        "AUTH_CLIENT_ID": "d06fd65a-5b79-45bc-8bfd-a856b8502330",
        "VIDEOS_API_URL": "https://videos.api.stage.alummahnow.net",
        "VIDEOS_WEB_URL": "https://videos.stage.alummahnow.net",
        "ADMIN_API_URL": "https://admin.api.stage.alummahnow.net",
        "ADMIN_WEB_URL": "https://admin.stage.alummahnow.net",
        "WWW_URL": "https://www.stage.alummahnow.net",
        "WWW_ORIGINS": "https://www.stage.alummahnow.net"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "al-ummah-now-cms-stage",
          "database_id": "1c882ccb-d894-494d-81bf-90ec80e32d73",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "al-ummah-now-cms-stage" }],
      // www's home timeline (docs/FEED.md): written only by this Worker, read by www (binding FEED there too).
      "kv_namespaces": [{ "binding": "FEED", "id": "33ddf8bb7eae439c91fcc4af22797f42" }],
      "queues": {
        "producers": [{ "binding": "VARIANTS", "queue": "al-ummah-now-cms-variants-stage" }, { "binding": "FEED_JOBS", "queue": "al-ummah-now-cms-feed-stage" }, { "binding": "AI_JOBS", "queue": "al-ummah-now-cms-ai-stage" }],
        "consumers": [
          { "queue": "al-ummah-now-cms-variants-stage", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 6, "max_concurrency": 4, "dead_letter_queue": "al-ummah-now-cms-variants-dlq-stage" },
          { "queue": "al-ummah-now-cms-feed-stage", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 6, "max_concurrency": 1, "dead_letter_queue": "al-ummah-now-cms-feed-dlq-stage" },
          { "queue": "al-ummah-now-cms-feed-dlq-stage", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
          { "queue": "al-ummah-now-cms-ai-stage", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5, "dead_letter_queue": "al-ummah-now-cms-ai-dlq-stage" },
          { "queue": "al-ummah-now-cms-ai-dlq-stage", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
        ]
      }
    },
    "qa": {
      "name": "al-ummah-now-cms-qa",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ai": { "binding": "AI" },
      "routes": [{ "pattern": "cms.qa.alummahnow.net", "custom_domain": true }],
      "triggers": { "crons": ["*/30 * * * *", "* * * * *"] },
      "vars": {
        "ENVIRONMENT": "qa",
        "PUBLIC_URL": "https://cms.qa.alummahnow.net",
        "AUTH_ISSUER": "https://auth.qa.alummahnow.net",
        "AUTH_CLIENT_ID": "0e613f49-674b-490a-93e5-97a35d586da1",
        "VIDEOS_API_URL": "https://videos.api.qa.alummahnow.net",
        "VIDEOS_WEB_URL": "https://videos.qa.alummahnow.net",
        "ADMIN_API_URL": "https://admin.api.qa.alummahnow.net",
        "ADMIN_WEB_URL": "https://admin.qa.alummahnow.net",
        "WWW_URL": "https://www.qa.alummahnow.net",
        "WWW_ORIGINS": "https://www.qa.alummahnow.net"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "al-ummah-now-cms-qa",
          "database_id": "29b338a0-db34-4480-a510-16680fe67441",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "al-ummah-now-cms-qa" }],
      // www's home timeline (docs/FEED.md): written only by this Worker, read by www (binding FEED there too).
      "kv_namespaces": [{ "binding": "FEED", "id": "6e459b34fb954cf4a199cfef57036a8c" }],
      "queues": {
        "producers": [{ "binding": "VARIANTS", "queue": "al-ummah-now-cms-variants-qa" }, { "binding": "FEED_JOBS", "queue": "al-ummah-now-cms-feed-qa" }, { "binding": "AI_JOBS", "queue": "al-ummah-now-cms-ai-qa" }],
        "consumers": [
          { "queue": "al-ummah-now-cms-variants-qa", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 6, "max_concurrency": 4, "dead_letter_queue": "al-ummah-now-cms-variants-dlq-qa" },
          { "queue": "al-ummah-now-cms-feed-qa", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 6, "max_concurrency": 1, "dead_letter_queue": "al-ummah-now-cms-feed-dlq-qa" },
          { "queue": "al-ummah-now-cms-feed-dlq-qa", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
          { "queue": "al-ummah-now-cms-ai-qa", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5, "dead_letter_queue": "al-ummah-now-cms-ai-dlq-qa" },
          { "queue": "al-ummah-now-cms-ai-dlq-qa", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
        ]
      }
    }
  }
}
