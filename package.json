{
  "name": "al-ummah-now-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:diff": "rm -f .schema-check/cms.db && mkdir -p .schema-check && bknd sync --sql",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:schema": "bash scripts/check-schema.sh",
    "check:migrations": "node --experimental-strip-types --no-warnings scripts/migration-guard.ts --base origin/main",
    "check:config": "node --experimental-strip-types --no-warnings scripts/check-wrangler-config.ts",
    "check:secrets": "node --experimental-strip-types --no-warnings scripts/check-secrets.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:schema && npm run check:migrations && npm run check:config && npm run check:client && npm run check:fanous",
    "build:dry": "wrangler deploy --dry-run --env= --outdir dist/production && wrangler deploy --dry-run --env stage --outdir dist/stage && wrangler deploy --dry-run --env qa --outdir dist/qa",
    "e2e": "playwright test",
    "release:smoke": "node --experimental-strip-types --no-warnings scripts/release/smoke.ts",
    "release:rollback": "node --experimental-strip-types --no-warnings scripts/release/rollback.ts",
    "cf-typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "check:committed-secrets": "node scripts/check-committed-secrets.mjs",
    "build:client": "node --experimental-strip-types --no-warnings scripts/build-admin-client.ts",
    "check:client": "node --experimental-strip-types --no-warnings scripts/build-admin-client.ts --check",
    "sync:fanous": "node --experimental-strip-types --no-warnings scripts/sync-fanous.ts",
    "check:fanous": "node --experimental-strip-types --no-warnings scripts/sync-fanous.ts --check"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "bknd": "0.21.0",
    "hono": "4.10.4",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "playwright": "1.64.1",
    "playwright-core": "1.64.1"
  }
}
